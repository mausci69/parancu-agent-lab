{
  "name": "ecosearch-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "dev:lan": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.1.112:8000 expo start --lan",
    "dev:tunnel": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.1.112:8000 expo start --tunnel",
    "test": "jest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.21.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-localization": "~17.0.9",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.10.0",
    "onnxruntime-react-native": "^1.24.3",
    "prettier": "^3.3.3",
    "react": "19.1.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.10.0",
    "eslint-config-expo": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ],
    "moduleNameMapper": {
      "^../local/(.*)$": "<rootDir>/__mocks__/local/$1"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/types.ts",
      "!src/**/index.ts",
      "!src/i18n/**"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/__mocks__/",
      "<rootDir>/src/i18n/",
      "<rootDir>/src/local/"
    ]
  }
}