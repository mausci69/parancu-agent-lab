  "description": "ParancU API exposes ParancU retrieval as a local HTTP service and connects it to Slack.",
  "main": "index.js",
  "scripts": {
    "workflow": "tsx src/testWorkflow.ts",
    "test:deterministic": "tsx --test src/workflow/runWorkflow.test.ts src/web/web.test.ts src/verifier/evidenceVerifier.test.ts src/observability/observability.test.ts evaluation/runMultiEvidenceEval.test.ts",
    "test": "npm run test:deterministic",
    "workflow:real": "tsx src/testRealCorpus.ts",
    "web:local": "tsx src/web/server.ts",
    "start": "tsx src/web/server.ts",
    "e5:verify": "tsx services/parancu-api/src/verifyE5Bundle.ts",
    "typecheck": "tsc --noEmit",
    "eval:multi-evidence": "tsx evaluation/runMultiEvidenceEval.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mausci69/ParancU_API_v0.1.git"
  },
