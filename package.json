    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.17",
    "@langfuse/core": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
