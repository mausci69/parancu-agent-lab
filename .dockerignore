# Allow only runtime sources, package metadata, and the E5 manifest/verifier.
**
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**/
!src/**/*.ts
!apps/
!apps/web/
!apps/web/index.html
!apps/web/app.js
!apps/web/styles.css
!apps/web/icon.png
!services/
!services/parancu-api/
!services/parancu-api/package.json
!services/parancu-api/package-lock.json
!services/parancu-api/src/
!services/parancu-api/src/lib/
!services/parancu-api/src/lib/**/
!services/parancu-api/src/lib/**/*.ts
!services/parancu-api/src/local/
!services/parancu-api/src/local/*.ts
!services/parancu-api/src/verifyE5Bundle.ts
!services/parancu-api/assets/
!services/parancu-api/assets/e5-manifest.json
**/node_modules
**/test*.ts
**/*.test.ts
**/*.eval.ts
**/.env*
**/.npmrc
**/*.key
**/*.pem
